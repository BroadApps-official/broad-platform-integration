flowchart TD
    Request["Logical placement request"] --> RequestedRemote["Requested remote"]
    RequestedRemote -->|"usable products"| Result["Paywall payload"]
    RequestedRemote -->|"empty / unavailable"| RequestedCache["Requested cache"]
    RequestedCache -->|"usable"| Result
    RequestedCache -->|"miss / unusable"| IsMain{"Requested = main?"}
    IsMain -->|"yes"| Safe["Safe empty / unavailable"]
    IsMain -->|"no"| MainRemote["Main remote"]
    MainRemote -->|"usable"| Result
    MainRemote -->|"empty / unavailable"| MainCache["Main cache"]
    MainCache -->|"usable"| Result
    MainCache -->|"miss / unusable"| Safe

